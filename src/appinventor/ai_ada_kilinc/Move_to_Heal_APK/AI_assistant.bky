<xml xmlns="https://developers.google.com/blockly/xml"><block type="component_event" id="1p=0Ey{?:T)NTf0b5Ras" x="-843" y="-507"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Form" is_generic="false" instance_name="AI_assistant" event_name="Initialize"></mutation><field name="COMPONENT_SELECTOR">AI_assistant</field><statement name="DO"><block type="component_set_get" id="~?[Vku8dBCQmh|%`W}t5"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Label1"></mutation><field name="COMPONENT_SELECTOR">Label1</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="*md0?ri+P/_N6Rj$fSq!"><field name="TEXT">Meet Mova — your personal AI rehabilitation assistant.   Mova is designed to guide you through a gentle, supported, and empowering recovery journey.  Ask her about your pain or movement challenges, and she’ll suggest the right exercises and gentle wellness tips. Let Mova support your healing — one movement at a time.</field></block></value></block></statement></block><block type="component_event" id="WA0m(5?5f?8XD/govfsC" x="-717" y="-351"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Button" is_generic="false" instance_name="Button1" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">Button1</field><statement name="DO"><block type="component_method" id="W]tJw7@z1iBHV;c[5BX,"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="ChatBot" method_name="Converse" is_generic="false" instance_name="ChatBot1"></mutation><field name="COMPONENT_SELECTOR">ChatBot1</field><value name="ARG0"><block type="text_join" id="}1jA9)PZ5R%.J1g*jU#*"><mutation xmlns="http://www.w3.org/1999/xhtml" items="2"></mutation><value name="ADD0"><block type="text" id="~[A~qk*(eo5:K(^ls#uj"><field name="TEXT">You are Mova, a personalized AI rehabilitation assistant designed for the "Move to Heal" app. Your purpose is to help users recover safely through movement.  This app focuses on three body regions: Neck &amp; Shoulder, Waist, and Knee &amp; Hip. Each region has three specific exercises available:  - For Neck &amp; Shoulder: Cross-Body Shoulder Stretch, Neck Stretch with Hand Assistance, Wall Shoulder Press. - For Waist: Glute Bridge, Double Knee to Chest, Cobra Stretch. - For Knee &amp; Hip: Side-Lying Leg Raise, Inner Thigh Lift, Wall Sit.  If the user describes pain or discomfort in one of these areas, recommend only the exercises listed above for that area. In addition to exercises, feel free to give simple wellness tips like rest, hydration, posture advice, and hot/cold compress use.  If the user describes intense pain, swelling, numbness, or loss of motion, kindly advise them to consult a medical professional. If the user simply greets you (e.g., "hello", "hi", "hey"), respond briefly and do not reintroduce yourself.Do not answer questions unrelated to physical rehabilitation. Remind the user that you are a rehab assistant focused on movement-based recovery.  Always respond with warmth, encouragement, and clarity — as Mova, you are friendly, supportive, and focused on safe recovery.</field></block></value><value name="ADD1"><block type="component_set_get" id="S2cIH[khvMY{:d072O8Y"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="TextBox" set_or_get="get" property_name="Text" is_generic="false" instance_name="TextBox1"></mutation><field name="COMPONENT_SELECTOR">TextBox1</field><field name="PROP">Text</field></block></value></block></value><next><block type="component_set_get" id="1vq~qgGMMp;ozY[]u(aJ"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="TextBox" set_or_get="set" property_name="Text" is_generic="false" instance_name="TextBox1"></mutation><field name="COMPONENT_SELECTOR">TextBox1</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="i8j[JIR-%!l8}2=`8i/G"><field name="TEXT"></field></block></value></block></next></block></statement></block><block type="component_event" id="K=^g@-Kc#qC=BlL6]FSW" x="-729" y="-113"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="ChatBot" is_generic="false" instance_name="ChatBot1" event_name="GotResponse"></mutation><field name="COMPONENT_SELECTOR">ChatBot1</field><statement name="DO"><block type="component_set_get" id="O]6(oUIY9g}wH;d+NGye"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Label1"></mutation><field name="COMPONENT_SELECTOR">Label1</field><field name="PROP">Text</field><value name="VALUE"><block type="lexical_variable_get" id="4LzWjIUJA1NpW9/~1a(@"><mutation xmlns="http://www.w3.org/1999/xhtml"><eventparam name="responseText"></eventparam></mutation><field name="VAR">responseText</field></block></value></block></statement></block><yacodeblocks xmlns="https://appinventor.mit.edu/ns/project/" ya-version="239" language-version="40"></yacodeblocks></xml>